# Server Configuration
PORT=5000
NODE_ENV=development
LOG_LEVEL=debug

# MongoDB Configuration
MONGODB_URI=mongodb://localhost:27017/pulse-chat
# For MongoDB Atlas:
# MONGODB_URI=mongodb+srv://username:password@cluster.mongodb.net/pulse-chat

# JWT Configuration
JWT_SECRET=your_super_secret_jwt_key_change_in_production_12345
JWT_EXPIRE=7d
JWT_REFRESH_SECRET=your_super_secret_refresh_key_change_in_production_12345
JWT_REFRESH_EXPIRE=30d

# File Upload Configuration
MAX_FILE_SIZE=5242880
UPLOAD_DIR=./uploads
ALLOWED_FILE_TYPES=image/jpeg,image/png,image/gif,application/pdf,text/plain

# CORS Configuration
FRONTEND_URL=https://connect-frontend-u0gc.onrender.com
BACKEND_URL=http://localhost:5000
ALLOWED_ORIGINS=https://connect-frontend-u0gc.onrender.com

# Socket.io Configuration
SOCKET_PING_INTERVAL=25000
SOCKET_PING_TIMEOUT=5000

# Email Configuration (Optional)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASS=your_app_password

# AWS S3 Configuration (Optional)
AWS_ACCESS_KEY_ID=your_access_key
AWS_SECRET_ACCESS_KEY=your_secret_key
AWS_REGION=us-east-1
AWS_S3_BUCKET=pulse-chat-files

# Redis Configuration (Optional - for caching/sessions)
REDIS_URL=redis://localhost:6379
